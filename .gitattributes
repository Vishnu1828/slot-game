# Git LFS — store large binary SOURCE art out of the normal git history so clones stay small.
# Only raw-assets/ binaries are tracked; text (.json/.fnt/.md), code, and generated public/assets
# (git-ignored) are NOT in LFS. After adding a new binary type, add a matching pattern here.
# Setup: `git lfs install` once per machine; CI checks out with `lfs: true`.
raw-assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.wav  filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.mp3  filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
